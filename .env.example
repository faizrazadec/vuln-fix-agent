# cp .env.example .env and fill in. .env is gitignored — keep A2A_TOKEN out of git.

# Bearer token callers must send. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
A2A_TOKEN=

# Public https URL of this agent. Baked into the agent card, so it must match the
# hostname you route to this tunnel — callers read it from the card to find the endpoint.
PUBLIC_URL=

# Connector token from the Cloudflare tunnel you create for this stack (dashboard
# -> Networks -> Tunnels -> Create (name it A2Claude-MacM5Pro) -> Docker: it's the value after `--token`).
TUNNEL_TOKEN=

# Project on your Mac that Claude Code operates in. Mounted read-write at /workspace.

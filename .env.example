# cp .env.example .env and fill in. .env is gitignored — keep A2A_TOKEN out of git.

# Bearer token callers must send. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
A2A_TOKEN=

# Base URL baked into the agent card — callers read it from the card to find the endpoint.
# Optional: defaults to the host port, which is right while the stack is local-only. Set it
# only if you put this behind a tunnel or proxy, and match the hostname routed there.
PUBLIC_URL=

# Project on your Mac that Claude Code operates in. Mounted read-write at /workspace.

# --- git / GitHub identity for the vuln-fix workflow ---
SSH_KEY_DIR=
SSH_AUTH_KEY=gh_auth_key_snapdev
SSH_SIGN_KEY=gh_sign_key_snapdev.pub
SSH_SIGN_KEY_PRIVATE=gh_sign_key_snapdev
GIT_USER_NAME=
GIT_USER_EMAIL=

# Fine-grained PAT: Contents Read + Pull requests Read/Write, org as resource owner.
# SSH pushes and signs; only PR creation needs this.
GH_TOKEN=
GH_READ_PACKAGES_TOKEN=
# Unlocks the agent key; ssh-agent in the container holds it after startup.
SSH_KEY_PASSPHRASE=

# Vanta API (Settings > Developer Console > Create > 'Manage Vanta').
VANTA_CLIENT_ID=
VANTA_CLIENT_SECRET=

# Slack Incoming Webhook for #development-and-pr-reviews
# (api.slack.com/apps > your app > Incoming Webhooks > Add New Webhook).
SLACK_WEBHOOK_URL=

#!/bin/bash
# Fire the vuln-fix agent for every registered project, one at a time.
# Meant to be run on a schedule (see com.faizraza.a2claude.vulnrun.plist).
#
#   ./VulnFixAgent          # run all projects serially
#
# Serial on purpose: the big repos (ai-hub, alkaline3) each have 400+ findings, so
# running them concurrently would hammer Claude usage, CPU and Docker at once.
set -u

DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR"

LOCK="/tmp/a2claude-run-all.lock"
LOG_TS() { date '+%Y-%m-%d %H:%M:%S'; }

# --- single-instance lock (mkdir is atomic) -------------------------------------
# If a prior run is still going, skip rather than stack a second batch on top.
if ! mkdir "$LOCK" 2>/dev/null; then
  # Steal a stale lock (>6h old) — a crashed run should not block forever.
  if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +360 2>/dev/null)" ]; then
    echo "$(LOG_TS) stale lock >6h — reclaiming"; rmdir "$LOCK" 2>/dev/null; mkdir "$LOCK" 2>/dev/null
  else
    echo "$(LOG_TS) another run-all is active ($LOCK) — skipping this trigger"; exit 0
  fi
fi
trap 'rmdir "$LOCK" 2>/dev/null' EXIT

# --- the agent must be reachable ------------------------------------------------
CARD="http://127.0.0.1:9999/.well-known/agent-card.json"
if ! curl -sf -m 10 -o /dev/null "$CARD"; then
  echo "$(LOG_TS) agent not reachable at $CARD — is the a2claude container up? aborting"
  exit 1
fi

# --- projects, in registry order ------------------------------------------------
PROJECTS=$(python3 -c 'import json;print(*json.load(open("projects.json")))' 2>/dev/null)
if [ -z "$PROJECTS" ]; then
  echo "$(LOG_TS) no projects in projects.json — nothing to do"; exit 0
fi

echo "$(LOG_TS) === run-all start: $PROJECTS ==="
for proj in $PROJECTS; do
  start=$(date +%s)
  echo "$(LOG_TS) --- $proj: starting ---"
  ./ask.sh "fix vulns in $proj"       # blocks until this project's task completes
  echo "$(LOG_TS) --- $proj: done in $(( $(date +%s) - start ))s ---"
done
echo "$(LOG_TS) === run-all finished ==="

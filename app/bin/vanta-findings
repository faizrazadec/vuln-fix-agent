#!/usr/bin/env python3
"""List Vanta vulnerabilities for a registered project.

    vanta-findings snapdev-backend            # human-readable
    vanta-findings snapdev-backend --json     # machine-readable, for the agent
    vanta-findings --check-registry           # do every project's assets resolve in Vanta?

Uses the Vanta REST API (OAuth2 client credentials), not the browser session — a
scraped `connect.sid` dies on logout AND the GraphQL payload carries a timestamped
`signedQuery` signature that expires within minutes, so replay is not viable.

Filters come from projects.json, never from the caller, so this cannot be pointed at
findings outside the registry.

Exit codes: 0 success (INCLUDING a genuinely empty finding list), 2 auth/network,
3 unknown project or no asset in scope resolves, 4 config missing.

Exit 0 always prints a JSON array in --json mode, so the caller can tell "no open
findings" from "the lookup failed" — previously a stale asset name aborted the whole
project with empty stdout and the agent could not distinguish the two.
"""

import json
import os
import pathlib
import sys
import urllib.error
import urllib.parse
import urllib.request

REGISTRY = pathlib.Path(__file__).resolve().parent.parent / "projects.json"
BASE = os.environ.get("VANTA_API_BASE", "https://api.vanta.com")
CLIENT_ID = os.environ.get("VANTA_CLIENT_ID", "")
CLIENT_SECRET = os.environ.get("VANTA_CLIENT_SECRET", "")
# Severity is a global policy, not a per-project knob — every project is scanned at all
# four levels. Override with VANTA_SEVERITIES="CRITICAL,HIGH" if you ever need to narrow.
SEVERITIES = [s.strip() for s in
              os.environ.get("VANTA_SEVERITIES", "CRITICAL,HIGH,MEDIUM,LOW").split(",") if s.strip()]


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def post_json(url, payload, headers=None):
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json", **(headers or {})},
    )
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.load(r)


def get_json(url, token):
    req = urllib.request.Request(
        url, headers={"Authorization": f"Bearer {token}", "Accept": "application/json"}
    )
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.load(r)


def get_token():
    if not CLIENT_ID or not CLIENT_SECRET:
        die(
            "VANTA_CLIENT_ID / VANTA_CLIENT_SECRET are not set.\n"
            "Create them in Vanta: Settings > Developer Console > Create > 'Manage Vanta',\n"
            "then put both in .env.",
            4,
        )
    try:
        tok = post_json(
            f"{BASE}/oauth/token",
            {
                "client_id": CLIENT_ID,
                "client_secret": CLIENT_SECRET,
                "scope": "vanta-api.all:read",
                "grant_type": "client_credentials",
            },
        )
    except urllib.error.HTTPError as e:
        die(f"Vanta rejected the credentials (HTTP {e.code}): {e.read()[:300]!r}", 2)
    except Exception as e:  # noqa: BLE001
        die(f"could not reach Vanta: {e}", 2)
    return tok["access_token"]


def resolve_assets(token, names):
    """Map human asset names (e.g. llm-gateway-production) to Vanta assetIds.

    The vuln records only carry an opaque targetId, so a name filter has to go through
    /v1/vulnerable-assets. Matching is exact on name, case-insensitive.
    """
    wanted = {n.lower() for n in names}
    ids = {}
    cursor = None
    while True:
        q = {"pageSize": 100}
        if cursor:
            q["pageCursor"] = cursor
        url = f"{BASE}/v1/vulnerable-assets?" + urllib.parse.urlencode(q)
        try:
            body = get_json(url, token)
        except urllib.error.HTTPError as e:
            die(f"could not list assets (HTTP {e.code})", 2)
        res = body.get("results", {})
        for a in res.get("data", []):
            if a.get("name", "").lower() in wanted:
                ids[a["name"]] = a["id"]
        info = res.get("pageInfo", {})
        if not info.get("hasNextPage"):
            break
        cursor = info.get("endCursor")
    missing = wanted - {n.lower() for n in ids}
    if missing:
        # Warn, do not abort. A single renamed or retired asset used to take the whole
        # project down with it (exit 3, empty stdout), so every run on that project was a
        # no-op nobody could tell apart from "clean". Findings for the assets that DO
        # resolve are still worth having; the warning goes to stderr so --json stays clean.
        print(
            f"WARNING: {len(missing)} of {len(wanted)} assets in scope are not in Vanta: "
            + ", ".join(sorted(missing))
            + "\n         Findings below cover only the assets that resolved. Fix the "
            "'vanta.assets' entry in projects.json, or re-register the asset in Vanta.",
            file=sys.stderr,
        )
    if not ids:
        # Nothing resolved at all: any list we returned would be silently scoped to
        # everything, which is worse than stopping.
        die(
            "none of this project's assets resolve in Vanta: "
            + ", ".join(sorted(wanted))
            + " — check the 'vanta.assets' entry in projects.json",
            3,
        )
    return list(ids.values())


def fetch(token, params):
    """Walk every page — the default pageSize is 10, so one call is never the whole set."""
    out = []
    cursor = None
    while True:
        q = dict(params, pageSize=100)
        if cursor:
            q["pageCursor"] = cursor
        url = f"{BASE}/v1/vulnerabilities?" + urllib.parse.urlencode(q, doseq=True)
        try:
            body = get_json(url, token)
        except urllib.error.HTTPError as e:
            if e.code in (401, 403):
                die("Vanta rejected the token — check the app's scopes.", 2)
            die(f"Vanta returned HTTP {e.code}: {e.read()[:300]!r}", 2)
        res = body.get("results", {})
        out.extend(res.get("data", []))
        info = res.get("pageInfo", {})
        if not info.get("hasNextPage"):
            return out
        cursor = info.get("endCursor")
        if not cursor:
            return out


def all_asset_names(token):
    """Every vulnerable-asset name Vanta knows, lowercased -> as spelled."""
    names = {}
    cursor = None
    while True:
        q = {"pageSize": 100}
        if cursor:
            q["pageCursor"] = cursor
        url = f"{BASE}/v1/vulnerable-assets?" + urllib.parse.urlencode(q)
        try:
            body = get_json(url, token)
        except urllib.error.HTTPError as e:
            die(f"could not list assets (HTTP {e.code})", 2)
        res = body.get("results", {})
        for a in res.get("data", []):
            names[a.get("name", "").lower()] = a.get("name", "")
        info = res.get("pageInfo", {})
        if not info.get("hasNextPage"):
            return names
        cursor = info.get("endCursor")


def check_registry(projects):
    """Report every projects.json asset name that Vanta does not know.

    A stale name here is invisible in normal operation — the project just quietly
    produces fewer findings — so it needs a command that goes looking for it. Run this
    after editing projects.json. Exit 1 if anything is stale.
    """
    known = all_asset_names(get_token())
    stale = 0
    for name, cfg in sorted(projects.items()):
        assets = (cfg.get("vanta") or {}).get("assets") or []
        if not assets:
            print(f"  {name:24} (no asset filter — all assets)")
            continue
        missing = [a for a in assets if a.lower() not in known]
        stale += len(missing)
        mark = "FAIL" if missing else "ok  "
        print(f"  {mark} {name:24} {len(assets) - len(missing)}/{len(assets)} resolve")
        for a in missing:
            print(f"         missing in Vanta: {a}")
    if stale:
        print(f"\n{stale} stale asset name(s). Re-register them in Vanta or correct "
              f"projects.json — findings for those assets are silently missing.",
              file=sys.stderr)
        return 1
    print(f"\nall {len(projects)} projects resolve cleanly")
    return 0


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    as_json = "--json" in sys.argv

    if not REGISTRY.exists():
        die(f"missing {REGISTRY}", 4)
    # Skip non-object entries such as the example registry's "_comment".
    projects = {k: v for k, v in json.loads(REGISTRY.read_text()).items()
                if isinstance(v, dict)}

    if "--check-registry" in sys.argv:
        sys.exit(check_registry(projects))

    if not args:
        die(f"usage: vanta-findings <project> [--json] | vanta-findings --check-registry"
            f"\nknown: {', '.join(projects)}")
    name = args[0]
    if name not in projects:
        die(f"'{name}' is not a registered project. Known: {', '.join(projects)}", 3)

    cfg = projects[name].get("vanta") or {}
    owners = projects[name].get("owners") or []
    if owners:
        # To stderr so it never corrupts the --json array on stdout, but the agent still sees it.
        tags = ", ".join(f"{o.get('name','?')} <@{o['slack_id']}>" for o in owners if o.get("slack_id"))
        print(f"owners: {tags}", file=sys.stderr)
    token = get_token()

    base = {"isDeactivated": "false"}
    if cfg.get("integrationId"):
        base["integrationId"] = cfg["integrationId"]

    # Filter by asset on the SERVER via vulnerableAssetId — the vuln record's targetId is
    # NOT reliably the asset id (it matched for one image by luck, not for others), so any
    # client-side id match is wrong. Let Vanta resolve the asset->finding relationship.
    asset_ids = resolve_assets(token, cfg["assets"]) if cfg.get("assets") else [None]

    found = []
    for aid in asset_ids:
        p = dict(base)
        if aid:
            p["vulnerableAssetId"] = aid
        for sev in SEVERITIES:
            found.extend(fetch(token, dict(p, severity=sev)))

    found.sort(key=lambda v: (v.get("severity") != "CRITICAL", v.get("remediateByDate") or ""))  # CRITICAL first, then soonest SLA

    if as_json:
        print(json.dumps(found, indent=2))
        return
    if not found:
        print(f"no open findings for {name}")
        return
    print(f"{len(found)} open findings for {name}:\n")
    print(f"  {'PACKAGE':34} {'CVE':18} {'SEV':9} {'FIXED IN':14} REMEDIATE BY")
    for v in found:
        print(
            f"  {(v.get('packageIdentifier') or '?')[:33]:34} "
            f"{(v.get('name') or '-')[:17]:18} "
            f"{(v.get('severity') or '?'):9} "
            f"{(v.get('fixedVersion') or '-')[:13]:14} "
            f"{(v.get('remediateByDate') or '-')[:10]}"
        )
    fixable = sum(1 for v in found if v.get("isFixable"))
    print(f"\n  {fixable}/{len(found)} have a fix available")


if __name__ == "__main__":
    main()
